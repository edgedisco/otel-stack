# ==============================================================================
# OpenTelemetry Stack Configuration
# ==============================================================================

# Host interface for published services. Keep loopback for local-only use.
# A non-loopback value requires firewalling, authenticated TLS ingress, and Grafana authentication.
OTEL_STACK_BIND_ADDRESS=127.0.0.1

# OTel Collector Ports & Versions
OTEL_COLLECTOR_VERSION=0.100.0
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8889

# Loki (Logs & OTLP Log ingestion)
LOKI_VERSION=3.0.0
LOKI_PORT=3100

# Tempo (Distributed Traces)
TEMPO_VERSION=2.4.1
TEMPO_PORT=3200

# Prometheus (Metrics)
PROMETHEUS_VERSION=v2.51.0
PROMETHEUS_PORT=9091

# Grafana (Dashboards & Visualization)
GRAFANA_VERSION=10.2.2
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
